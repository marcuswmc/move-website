# Connection string do cluster MongoDB Atlas.
# Atlas → Database → Connect → Drivers. Inclua o nome do banco antes do "?":
#   mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/move-social?retryWrites=true&w=majority
DATABASE_URL=

# String longa e aleatória usada para assinar os tokens do Payload.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
