# Connection string do cluster MongoDB Atlas.
# Atlas → Database → Connect → Drivers. Inclua o nome do banco antes do "?":
#   mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/move-social?retryWrites=true&w=majority
DATABASE_URL=

# String longa e aleatória usada para assinar os tokens do Payload.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Token do Vercel Blob store (público), onde ficam os uploads da collection Media.
# Vercel → Storage → o Blob store → aba .env.local. Formato: vercel_blob_rw_<store>_<hash>.
# Obrigatório também em dev: sem ele o Payload volta a gravar em disco local, e como o
# banco é o mesmo de produção o site passa a apontar para arquivos que não existem lá.
BLOB_READ_WRITE_TOKEN=
